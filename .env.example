NODE_ENV=production
PORT=3000

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEFAULT_CHANNEL_ID=
# Separate channel for 3 persistent Secret/Eternal/Divine Last Seen messages
LAST_SEEN_CHANNEL_ID=
DISCORD_DEV_GUILD_ID=

INGEST_SHARED_SECRET=replace-with-long-random-secret
INGEST_MAX_SKEW_SECONDS=60
INGEST_RATE_LIMIT_PER_MINUTE=120

# Private live-source configuration (store real endpoints only in Railway)
LIVE_SOURCE_URLS=
LIVE_FEED_POLL_MS=800
LIVE_FEED_TIMEOUT_MS=5000
LIVE_FEED_MAX_AGE_SECONDS=600
LIVE_FEED_STALE_AFTER_SECONDS=30

# Live Discord source monitor
SOURCE_MONITOR_ENABLED=true
ALERT_RARITIES=Secret,Eternal,Divine
DISCORD_SOURCE_CHANNEL_IDS=
DISCORD_SOURCE_BOT_IDS=
SOURCE_STALE_AFTER_SECONDS=180

# Auto-update / new-egg discovery
AUTO_DISCOVERY_ENABLED=true
AUTO_DISCOVERY_POLL_SECONDS=90
DISCOVERY_SOURCES_JSON=
DISCOVERY_ALLOWED_HOSTS=
AUTO_DISCOVERY_MIN_CONFIDENCE=55
AUTO_DISCOVERY_CHANGE_CONFIDENCE=60
CATALOG_MAINTENANCE_INTERVAL_HOURS=6

# Supabase durable tracker storage (secrets live only in Railway)
SUPABASE_PERSISTENCE_ENABLED=true
TRACKER_STORAGE_URL=
TRACKER_STORAGE_SECRET=
TRACKER_STORAGE_TIMEOUT_MS=5000
TRACKER_STORAGE_RETRIES=2

# Server Finder
SERVER_FINDER_PLACE_ID=107778070777162
SERVER_FINDER_MAX_PLAYERS=1
# Up to 100 low-player servers can be collected per finder snapshot.
SERVER_FINDER_MAX_RESULTS=100
SERVER_FINDER_MAX_PAGES=8
SERVER_FINDER_CACHE_TTL_MS=15000

# Image processing
# Production uses verified transparent source art only.
SOURCE_IMAGE_ALPHA_ONLY=true
PUBLIC_BASE_URL=

# Dedup / cache tuning
SEMANTIC_DEDUP_SECONDS=20
SEEN_TTL_SECONDS=900
MEMORY_SOFT_LIMIT_MB=350
MEMORY_HARD_LIMIT_MB=450


# Load-shedding / concurrency guards
HTTP_MAX_CONCURRENT=250
SOURCE_PROCESS_MAX_CONCURRENCY=24
SOURCE_PROCESS_QUEUE_MAX=5000
ALERT_QUEUE_MAX=500
ALERT_QUEUE_WORKERS=8
ALERT_QUEUE_RESERVED_LIVE_SLOTS=50
ADMIN_AUTH_FAILURES_PER_MINUTE=10
MAX_DEDUP_KEYS=250000
MAX_RELIABILITY_KEYS=50000
RELIABILITY_EVIDENCE_TTL_SECONDS=1800
SERVER_FINDER_MAX_SESSIONS=10000
SERVER_FINDER_MAX_COOLDOWN_ENTRIES=100000

# Alert mentions
ALERT_MENTION_MODE=role
ALERT_SECRET_ROLE_ID=
ALERT_ETERNAL_ROLE_ID=
ALERT_DIVINE_ROLE_ID=

# Optional custom server emojis
ALERT_EMOJI_SECRET=🥚
ALERT_EMOJI_ETERNAL=🥚
ALERT_EMOJI_DIVINE=🥚
