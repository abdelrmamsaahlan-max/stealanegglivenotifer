NODE_ENV=production
PORT=3000

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEFAULT_CHANNEL_ID=
# Separate channel for 3 persistent Secret/Eternal/Divine Last Seen messages
LAST_SEEN_CHANNEL_ID=
DISCORD_DEV_GUILD_ID=

INGEST_SHARED_SECRET=replace-with-long-random-secret
INGEST_MAX_SKEW_SECONDS=60
INGEST_RATE_LIMIT_PER_MINUTE=120

# Private live-source configuration (store real endpoints only in Railway)
LIVE_SOURCE_URLS=
LIVE_FEED_POLL_MS=800
LIVE_FEED_TIMEOUT_MS=5000
LIVE_FEED_MAX_AGE_SECONDS=600
LIVE_FEED_STALE_AFTER_SECONDS=30

# Live Discord source monitor
SOURCE_MONITOR_ENABLED=true
ALERT_RARITIES=Secret,Eternal,Divine
DISCORD_SOURCE_CHANNEL_IDS=
DISCORD_SOURCE_BOT_IDS=
SOURCE_STALE_AFTER_SECONDS=180

# Auto-update / new-egg discovery
AUTO_DISCOVERY_ENABLED=true
AUTO_DISCOVERY_POLL_SECONDS=90
DISCOVERY_SOURCES_JSON=
EVENT_ALERTS_ENABLED=true

# Image processing
# Production uses verified transparent source art only.
SOURCE_IMAGE_ALPHA_ONLY=true
PUBLIC_BASE_URL=

# Dedup / cache tuning
SEMANTIC_DEDUP_SECONDS=20
SEEN_TTL_SECONDS=900
MEMORY_SOFT_LIMIT_MB=350
MEMORY_HARD_LIMIT_MB=450

# Rift tracker
RIFT_ALERTS_ENABLED=true
RIFT_BOSS_ALERTS_ENABLED=true
RIFT_SOURCE_CHANNEL_IDS=
RIFT_SOURCE_BOT_IDS=
RIFT_ALERT_MENTION_MODE=none
RIFT_ALERT_ROLE_ID=
RIFT_DEDUP_SECONDS=10800

# Alert mentions
ALERT_MENTION_MODE=role
ALERT_SECRET_ROLE_ID=
ALERT_ETERNAL_ROLE_ID=
ALERT_DIVINE_ROLE_ID=

# Optional custom server emojis
ALERT_EMOJI_SECRET=🥚
ALERT_EMOJI_ETERNAL=🥚
ALERT_EMOJI_DIVINE=🥚
